# ==========================================
# idle-smoke .gitignore
# ==========================================

# ── Boilerplate & Workspace Exclusions ────
boilerplate/
.boilerplate/
reference-docs/
.kennel-hub/
.style-guide/

# ── Dependencies ──────────────────────────
node_modules/
.pnpm-store/
.npm/

# ── Environment & Secrets ─────────────────
# Secrets & local environment variables (Doppler handles these)
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# GCP Service Account & Credentials Keys
*service-account*.json
*credentials*.json
*.pem
*.key
*.p12
*.pfx

# Doppler & Wrangler Local State
.doppler/
.wrangler/

# ── Build & Output Directories ────────────
dist/
dist-ssr/
build/
out/
.vite/
.next/
.nuxt/
.output/

# ── Cache & Temporary Files ───────────────
.cache/
.temp/
tmp/
*.tmp
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache
*.tsbuildinfo

# ── Operating System (macOS / Google Drive)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── IDEs & Editors ────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Testing & Coverage ────────────────────
playwright-report/
test-results/
coverage/
.nyc_output/
