{
  "name": "idle-smoke-break",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "build": "npm run typecheck && vite build",
    "start": "node server/index.js",
    "preview": "vite preview --host 127.0.0.1",
    "version:next": "node scripts/version.mjs",
    "db:inspect": "node --no-warnings scripts/db-inspect.mjs",
    "db:d1:init": "node --no-warnings scripts/db-inspect.mjs --d1-init",
    "db:live": "node --no-warnings scripts/db-inspect.mjs --d1-remote",
    "test:unit": "vitest run src",
    "test:browser": "playwright test",
    "test": "npm run test:unit && npm run test:browser"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "knip": "^6.41.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  },
  "knip": {
    "entry": [
      "server/worker.js"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
