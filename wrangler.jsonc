{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "idle-smoke",
  "main": "server/worker.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "vars": {
    "VITE_APPLE_CLIENT_ID": "com.idlemullet.smokebreak.web",
    "VITE_GOOGLE_CLIENT_ID": "1025793893376-qi50o9ksk2kigndaie0ap3a1o0jh3dtj.apps.googleusercontent.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "idle-smoke-break-db",
      "database_id": "8b2be842-3a52-4b47-8044-d0e3a2a8014d"
    }
  ],
  "routes": [
    {
      "pattern": "idlemullet.com/idle-smoke*",
      "zone_name": "idlemullet.com"
    },
    {
      "pattern": "www.idlemullet.com/idle-smoke*",
      "zone_name": "idlemullet.com"
    }
  ],
  "env": {
    "staging": {
      "name": "idle-smoke-staging",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "VITE_APPLE_CLIENT_ID": "com.idlemullet.smokebreak.web",
        "VITE_GOOGLE_CLIENT_ID": "1025793893376-qi50o9ksk2kigndaie0ap3a1o0jh3dtj.apps.googleusercontent.com"
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "idle-smoke-break-staging-db",
          "database_id": "dd89ff12-7a6c-421f-b72c-4c8c298b0963"
        }
      ]
    }
  }
}

