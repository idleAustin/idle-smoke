{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "idle-smoke",
  "main": "server/worker.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "idlemullet.com/idle-smoke*",
      "zone_name": "idlemullet.com"
    },
    {
      "pattern": "www.idlemullet.com/idle-smoke*",
      "zone_name": "idlemullet.com"
    }
  ],
  "env": {
    "staging": {
      "name": "idle-smoke-staging",
      "workers_dev": true,
      "routes": [],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
      }
    }
  }
}

